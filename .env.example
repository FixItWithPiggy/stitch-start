# Copy this file to ".env" and fill in the two values from your Supabase project:
# Supabase dashboard -> Project Settings -> API (or "Connect").
# Leave them empty to run the app in demo mode (no accounts, saved on the device only).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=

# NEVER put your Claude API key here. Anything starting with EXPO_PUBLIC_ ends up inside the app
# where anyone can read it. The Claude key goes in Supabase as a secret (see LAUNCH-GUIDE.md).
